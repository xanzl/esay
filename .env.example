# ==================== 数据库 ====================
# d1（Cloudflare Workers 推荐）或 postgresql（Vercel / Netlify）
DB_TYPE=d1

# 仅 DB_TYPE=postgresql 时必填（Neon / Supabase 等连接串）
DATABASE_URL=postgres://user:password@host:5432/moment

# ==================== 存储 ====================
# r2（Cloudflare 推荐）或 s3（S3 兼容服务）
STORAGE_TYPE=r2

# 仅 STORAGE_TYPE=s3 时必填
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# ==================== 认证 ====================
# JWT 签名密钥。可选：不配置时自动生成并持久化到数据库（部署/重启不失效），
# 建议仍配置固定值（随机长字符串，如 openssl rand -hex 32），便于多环境共用。
JWT_SECRET=change-me-to-a-long-random-string

# ==================== 扩展解析 ====================
# GitHub API Token（可选）：解析 GitHub 项目卡片时携带，配额从 60 次/小时提升到 5000 次/小时。
# 生成：https://github.com/settings/tokens 创建 fine-grained token（只读公共仓库即可）。
# Cloudflare 部署用：wrangler secret put GITHUB_TOKEN
GITHUB_TOKEN=

# ==================== 公开 API ====================
# 是否开启公开 API（false 时 /api/public/* 返回 404）
PUBLIC_API_ENABLED=true
# 站点完整域名，用于公开 API 返回图片的绝对地址（不配则回退为请求域名）
APP_URL=https://example.com